{
  "description": "Filled contour bands plus isolines traced by a contours binding (contourpy), over country borders. Inputs: -i fcst=<forecast Zarr: step x latitude x longitude, variable tp>.",
  "title": {
    "text": "Week 1 ensemble-mean precipitation, filled contours with isolines"
  },
  "width": 411,
  "height": 500,
  "projection": {
    "type": "equirectangular"
  },
  "datasets": {
    "bands": {
      "zarr": "fcst",
      "sel": {
        "step": "7D"
      },
      "contours": {
        "variable": "tp",
        "levels": [
          0,
          5,
          10,
          20,
          30,
          40,
          50,
          75,
          100,
          150,
          200
        ],
        "filled": true
      }
    },
    "lines": {
      "zarr": "fcst",
      "sel": {
        "step": "7D"
      },
      "contours": {
        "variable": "tp",
        "levels": [
          10,
          30,
          50,
          75
        ]
      }
    },
    "borders": {
      "naturalearth": "borders",
      "scale": "50m"
    }
  },
  "layer": [
    {
      "data": {
        "name": "bands"
      },
      "mark": {
        "type": "geoshape",
        "clip": true
      },
      "encoding": {
        "color": {
          "field": "properties.mid",
          "type": "quantitative"
        }
      }
    },
    {
      "data": {
        "name": "lines"
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "black",
        "strokeWidth": 0.6,
        "clip": true
      }
    },
    {
      "data": {
        "name": "borders"
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#222",
        "strokeWidth": 1.3,
        "clip": true
      }
    }
  ]
}
