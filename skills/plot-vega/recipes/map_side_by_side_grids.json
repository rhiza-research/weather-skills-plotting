{
  "description": "Two products side by side, each at its native resolution (no regridding), cropped to the same bbox, sharing one legend. Inputs: -i obs=<grid Zarr, variable precip> -i fcst=<forecast Zarr: step x latitude x longitude, variable tp>.",
  "title": "Week 1: CHIRPS 0.05° beside ECMWF 0.25°, each on its own grid",
  "datasets": {
    "obs": {
      "zarr": "obs",
      "fields": {
        "lon": "longitude.lo",
        "lon2": "longitude.hi",
        "lat": "latitude.lo",
        "lat2": "latitude.hi",
        "precip": "precip"
      }
    },
    "fcst": {
      "zarr": "fcst",
      "sel": {
        "step": "7D"
      },
      "bbox": [
        5,
        33.5,
        -5,
        42
      ],
      "fields": {
        "lon": "longitude.lo",
        "lon2": "longitude.hi",
        "lat": "latitude.lo",
        "lat2": "latitude.hi",
        "precip": "tp"
      }
    },
    "borders": {
      "naturalearth": "borders",
      "scale": "10m"
    }
  },
  "hconcat": [
    {
      "title": "CHIRPS 0.05°",
      "width": 300,
      "height": 355,
      "projection": {
        "type": "equirectangular"
      },
      "layer": [
        {
          "data": {
            "name": "obs"
          },
          "mark": {
            "type": "rect",
            "clip": true
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "lon2"
            },
            "latitude2": {
              "field": "lat2"
            },
            "color": {
              "field": "precip",
              "type": "quantitative"
            }
          }
        },
        {
          "data": {
            "name": "borders"
          },
          "mark": {
            "type": "geoshape",
            "filled": false,
            "stroke": "#222",
            "clip": true
          }
        }
      ]
    },
    {
      "title": "ECMWF 0.25° (ensemble mean)",
      "width": 300,
      "height": 355,
      "projection": {
        "type": "equirectangular"
      },
      "layer": [
        {
          "data": {
            "name": "fcst"
          },
          "mark": {
            "type": "rect",
            "clip": true
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "longitude2": {
              "field": "lon2"
            },
            "latitude2": {
              "field": "lat2"
            },
            "color": {
              "field": "precip",
              "type": "quantitative"
            }
          }
        },
        {
          "data": {
            "name": "borders"
          },
          "mark": {
            "type": "geoshape",
            "filled": false,
            "stroke": "#222",
            "clip": true
          }
        }
      ]
    }
  ],
  "resolve": {
    "scale": {
      "color": "shared"
    }
  }
}
