{
  "title": {
    "text": "10 m wind",
    "subtitle": "Speed shaded, arrows every 3rd grid point (1.5\u00b0)"
  },
  "width": 480,
  "height": 480,
  "projection": {
    "type": "equirectangular",
    "fit": {
      "$bbox": [
        12,
        28,
        -12,
        52
      ]
    }
  },
  "datasets": {
    "cells": {
      "zarr": "wind",
      "fields": {
        "lon": "longitude.lo",
        "lon2": "longitude.hi",
        "lat": "latitude.lo",
        "lat2": "latitude.hi",
        "u": "u10",
        "v": "v10"
      }
    },
    "arrows": {
      "zarr": "wind",
      "isel": {
        "latitude": {
          "step": 3
        },
        "longitude": {
          "step": 3
        }
      },
      "fields": {
        "lon": "longitude",
        "lat": "latitude",
        "u": "u10",
        "v": "v10"
      }
    },
    "coast": {
      "naturalearth": "coastline",
      "scale": "50m",
      "bbox": [
        12,
        28,
        -12,
        52
      ]
    },
    "borders": {
      "naturalearth": "borders",
      "scale": "50m",
      "bbox": [
        12,
        28,
        -12,
        52
      ]
    }
  },
  "layer": [
    {
      "data": {
        "name": "cells"
      },
      "transform": [
        {
          "calculate": "sqrt(datum.u * datum.u + datum.v * datum.v)",
          "as": "speed"
        }
      ],
      "mark": {
        "type": "rect",
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "longitude2": {
          "field": "lon2"
        },
        "latitude2": {
          "field": "lat2"
        },
        "color": {
          "field": "speed",
          "type": "quantitative",
          "title": "Wind speed [m/s]",
          "scale": {
            "scheme": "yellowgreen",
            "domain": [
              0,
              12
            ],
            "clamp": true
          }
        }
      }
    },
    {
      "data": {
        "name": "coast"
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#333",
        "strokeWidth": 0.8,
        "clip": true
      }
    },
    {
      "data": {
        "name": "borders"
      },
      "mark": {
        "type": "geoshape",
        "filled": false,
        "stroke": "#333",
        "strokeWidth": 0.8,
        "clip": true
      }
    },
    {
      "data": {
        "name": "arrows"
      },
      "transform": [
        {
          "calculate": "sqrt(datum.u * datum.u + datum.v * datum.v)",
          "as": "arrow_speed"
        },
        {
          "calculate": "atan2(datum.u, datum.v) * 180 / PI",
          "as": "toward"
        }
      ],
      "mark": {
        "type": "point",
        "shape": "M0,1 L0,-1 M-0.4,-0.45 L0,-1 L0.4,-0.45",
        "filled": false,
        "stroke": "black",
        "strokeWidth": 1.3,
        "opacity": 1,
        "clip": true
      },
      "encoding": {
        "longitude": {
          "field": "lon",
          "type": "quantitative"
        },
        "latitude": {
          "field": "lat",
          "type": "quantitative"
        },
        "angle": {
          "field": "toward",
          "type": "quantitative",
          "scale": null
        },
        "size": {
          "field": "arrow_speed",
          "type": "quantitative",
          "scale": {
            "type": "pow",
            "exponent": 2,
            "domain": [
              0,
              12
            ],
            "range": [
              0,
              1296
            ]
          },
          "legend": {
            "title": "Arrows",
            "values": [
              5,
              10
            ],
            "labelExpr": "datum.label + ' m/s'",
            "symbolType": "M0,1 L0,-1 M-0.4,-0.45 L0,-1 L0.4,-0.45",
            "symbolStrokeColor": "black",
            "symbolStrokeWidth": 1.3,
            "symbolFillColor": "transparent"
          }
        }
      }
    }
  ],
  "resolve": {
    "legend": {
      "color": "independent",
      "size": "independent"
    }
  }
}
