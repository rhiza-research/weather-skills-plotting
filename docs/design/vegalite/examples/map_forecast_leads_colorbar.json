{
  "title": "ECMWF ensemble-mean weekly precipitation, init 1 Oct 2026",
  "datasets": {
    "fcst": {
      "zarr": "fcst",
      "fields": {
        "lon": "longitude.lo",
        "lon2": "longitude.hi",
        "lat": "latitude.lo",
        "lat2": "latitude.hi",
        "lead_days": "step",
        "tp": "tp"
      }
    },
    "borders": {
      "naturalearth": "borders",
      "scale": "50m",
      "bbox": [
        6,
        33,
        -5.5,
        42.5
      ]
    },
    "coast": {
      "naturalearth": "coastline",
      "scale": "50m",
      "bbox": [
        6,
        33,
        -5.5,
        42.5
      ]
    }
  },
  "vconcat": [
    {
      "data": {
        "name": "fcst"
      },
      "transform": [
        {
          "calculate": "'Week ' + (datum.lead_days / 7)",
          "as": "week"
        }
      ],
      "facet": {
        "field": "week",
        "type": "ordinal",
        "title": null
      },
      "columns": 4,
      "spec": {
        "width": 170,
        "height": 205,
        "projection": {
          "type": "equirectangular",
          "fit": {
            "$bbox": [
              6,
              33,
              -5.5,
              42.5
            ]
          }
        },
        "layer": [
          {
            "mark": {
              "type": "rect",
              "clip": true
            },
            "encoding": {
              "longitude": {
                "field": "lon",
                "type": "quantitative"
              },
              "latitude": {
                "field": "lat",
                "type": "quantitative"
              },
              "longitude2": {
                "field": "lon2"
              },
              "latitude2": {
                "field": "lat2"
              },
              "color": {
                "field": "tp",
                "type": "quantitative",
                "legend": null,
                "scale": {
                  "$palette": "default_precip",
                  "data": "fcst.tp"
                }
              }
            }
          },
          {
            "data": {
              "name": "coast"
            },
            "mark": {
              "type": "geoshape",
              "filled": false,
              "stroke": "#222",
              "strokeWidth": 0.7,
              "clip": true
            }
          },
          {
            "data": {
              "name": "borders"
            },
            "mark": {
              "type": "geoshape",
              "filled": false,
              "stroke": "#222",
              "strokeWidth": 1,
              "clip": true
            }
          }
        ]
      }
    },
    {
      "$colorbar": "default_precip",
      "data": "fcst.tp",
      "length": 560,
      "thickness": 14
    }
  ],
  "config": {
    "concat": {
      "spacing": 6
    }
  }
}
